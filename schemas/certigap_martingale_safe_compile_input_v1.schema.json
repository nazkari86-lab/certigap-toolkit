{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nazkari86-lab/certigap-toolkit/schemas/certigap_martingale_safe_compile_input_v1.schema.json",
  "title": "CertiGap martingale safe compile input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "values", "train_trace", "monitoring_trace"],
  "properties": {
    "schema": {"const": "certigap-martingale-safe-compile-input-v1"},
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number"}
    },
    "train_trace": {"$ref": "#/$defs/trace"},
    "monitoring_trace": {"$ref": "#/$defs/trace"},
    "test_trace": {
      "oneOf": [{"$ref": "#/$defs/trace"}, {"type": "null"}]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aggregate": {"enum": ["sum", "min", "max"]},
        "budget": {"type": "integer", "minimum": 0},
        "tail_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "memory_limit_slots": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "max_depth": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "require_persistent_snapshots": {"type": "boolean"},
        "memory_weight": {"type": "number", "minimum": 0},
        "build_weight": {"type": "number", "minimum": 0},
        "array_unit_cost": {"type": "number", "exclusiveMinimum": 0},
        "prefix_unit_cost": {"type": "number", "exclusiveMinimum": 0},
        "fenwick_unit_cost": {"type": "number", "exclusiveMinimum": 0},
        "sqrt_unit_cost": {"type": "number", "exclusiveMinimum": 0},
        "segment_tree_unit_cost": {"type": "number", "exclusiveMinimum": 0},
        "sparse_unit_cost": {"type": "number", "exclusiveMinimum": 0},
        "certirange_unit_cost": {"type": "number", "exclusiveMinimum": 0},
        "range_beam_width": {"type": "integer", "minimum": 1},
        "range_candidate_limit": {"type": "integer", "minimum": 3}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deployment_alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "revocation_alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "minimum_observations": {"type": "integer", "minimum": 1},
        "minimum_post_deployment_observations": {"type": "integer", "minimum": 1},
        "horizon_operations": {"type": "integer", "minimum": 1},
        "migration_cost_units": {"type": "number", "minimum": 0},
        "build_cost_per_unit": {"type": "number", "minimum": 0},
        "minimum_improvement": {"type": "number", "minimum": 0},
        "revocation_tolerance": {"type": "number", "minimum": 0},
        "betting_fractions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "safe_baselines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sorted_array", "prefix_sum", "fenwick",
              "sqrt_decomposition", "segment_tree", "sparse_table",
              "certirange_point", "certirange_range"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "operations"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "left"],
            "properties": {
              "kind": {"enum": ["get", "range", "update"]},
              "left": {"type": "integer", "minimum": 1},
              "right": {"type": "integer", "minimum": 1},
              "value": {"type": "number"}
            }
          }
        }
      }
    }
  }
}
